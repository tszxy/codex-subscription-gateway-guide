# shell syntax for Linux/macOS. Windows PowerShell uses $env:NAME = 'value'.
export ANTHROPIC_BASE_URL="https://gateway.example.com"
export ANTHROPIC_AUTH_TOKEN="REPLACE_WITH_RANDOM_GATEWAY_KEY"
export ANTHROPIC_MODEL="gpt-6.1-sol"
export ANTHROPIC_DEFAULT_SONNET_MODEL="gpt-6.1-sol"
export ANTHROPIC_DEFAULT_OPUS_MODEL="gpt-6.1-sol"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="gpt-6-luna"

